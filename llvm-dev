#!/bin/sh
# Thin launcher for the native CLI; no build logic lives here.
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$project_dir/target/release/llvm-dev" ]; then
  printf '%s\n' 'Build the native CLI first: cargo build --release --workspace' >&2
  exit 1
fi
exec "$project_dir/target/release/llvm-dev" "$@"
